<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy API y admin a Waitress" stopProcessing="true">
          <match url="^(api/.*|admin/.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8004/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>